\section{Introdução}

 \frame
 {
    \frametitle{Objetivos}

    - Descrição do Problema
        \begin{itemize}
        \item Planta de inertização de resíduos por plasma térmico.
        \item Descrição do que foi feito ate agora.
        \end{itemize}
    - Proposta do doutorado

    - Estado da arte:
        \begin{itemize}
        \item Neste tópico serão expostos os artigos mais importantes da pesquisa bibliográfica.
        \end{itemize}
 }
 \frame
 {

    \frametitle{Motivação}

     - Problemas ecológicos enfrentados pela humanidade como a poluição do meio ambiente por resíduos tóxicos (lixo, hospitalar, etc.)

     - Prover ao sistema
        \begin{itemize}
        \item Automação total da planta.
        \end{itemize}

     - Controle
        \begin{itemize}
        \item Estudar diferentes técnicas de controle avançado na tocha e na planta de inertização.
        \item Estudar diferentes técnicas de otimização.
        \end{itemize}
 }

\section{Descrição do problema}

 \frame
 {

   \frametitle{Planta de Inertização de Resíduos por Plasma Térmico}

    \begin{itemize}
    \item Tem como objetivo eliminar material poluente para o meio ambiente (lixo, resíduo hospitalar, resíduos de petróleo, etc.. ).
    \item Propõe o desenvolvimento de um sistema de controle para uma planta de processamento de resíduos e efluentes petroquímicos utilizando plasma térmico.
    \item O sistema será basicamente composto por uma tocha a plasma, dois reatores (principal e secundário), um sistema de refrigeração da tocha, um sistema de lavagem de gases, um sistema de bombeamento de gases e uma fonte de alimentação operando na faixa de RF.
    \item O sistema será monitorado por um $CLP$ e um microcomputador PC com uma interface homem-máquina $IHM$.
    \end{itemize}
 }
 \frame
 {

 \frametitle{Planta de Inertização de Resíduos por Plasma Térmico}


    \begin{figure}[htbp!] \centering
    \includegraphics[scale=.34]{planta}
    \end{figure}

 }
 \frame
 {

   \frametitle{Fonte de Rádio Frequência}

    \begin{itemize}
    \item Sua finalidade é excitar a tocha de plasma indutiva, assegurando a manutenção do jato plasmático nas condições fixadas pelo processo.

    \item Conversor AC/DC: É utilizado para eliminar os harmónicas gerados pela fonte que reduzem o fator de potência , formado por:conversor boost trifásico , $DSP$ - monitoração e $PWM$, placa condicionadora de sinal - corrente e voltagem, Sensores de corrente, Barramento $DC$.

    \item Conversor DC/AC: Trabalha em alta freqüência $450kH$, sobre um conjunto de quatro módulos inversores ressonantes a $IGBT's$, agrupados em configuração paralela e isolados da carga por um transformador $RF$ (acoplamento de impedâncias), potencia de saída $50KW$.


    \end{itemize}
 }
 \frame
 {

 \frametitle{Fonte de Radio Frequência}


    \begin{figure}[htbp!] \centering
    \includegraphics[scale=.47]{RF}
    \end{figure}

 }
 \frame
 {

  \frametitle{Tocha a plasma acoplado indutivamente $ICP$}

    \begin{itemize}
    \item As tochas a plasma acoplado indutivamente tem ocupado um espaço crescente, devido às suas propriedades estruturais e amplo campo de aplicações industriais.

    \item A energia da fonte RF é transferida para o plasma por meio de um campo magnético oscilante, produzido por uma bobina de indução externa.

    \item O campo elétrico induzido produz um fluxo de corrente que dá origem às correntes que aquecem o gás em altas temperaturas, mantendo-o em estado de condução através do fenômeno de ionização produzido pelo processo térmico de colisão das partículas.

    \end{itemize}
 }
 \frame
 {

 \frametitle{Tocha a plasma acoplado indutivamente $ICP$}


    \begin{figure}[htbp!] \centering
    \includegraphics[scale=.48]{tocha}
    \end{figure}

 }



 \section{proposta do doutorado}
 \frame
 {
   \frametitle{Automação e Controle da Planta de Inertização de Resíduos por Plasma Térmico}
   \begin{itemize}
   \item Monitorar todas as variaveis utilizadas na planta
   \item Comunicação Fonte RF com CLP.
   \item Estudar estratégias de controle avanzado: PID, Fuzzy, Redes neurais, Neuro Fuzzy, etc.
   \item Estudar estratégias de otimização.
   \item Controle da Tocha (4 variaveis).
   \item Controle da Planta ( Interação com todos os elementos dela )
   \end{itemize}

 }
 \frame
 {

 \frametitle{Automação e controle da Planta de Inertização de Resíduos por Plasma Térmico}


    \begin{figure}[htbp!] \centering
    \includegraphics[scale=.32]{SistComp}
    \end{figure}

 }
 \section{Estado da Arte}
  \frame
 {

    \begin{itemize}
     \item As informações atuais da planta de inertização forem obtidas por meio dos seguentes artigos e teses: { \bf Automation system applied to a plasma inertization plant; A 50Kw PFC three-phase rectifier for using in a plasma torch system, Luciano P. S. Júnior 2007 (artigo); Conversor CC/CA de alta frequência baseado em inversores ressonantes com comutação sequencial para excitação de uma tocha indutiva a plasma térmico, Dubut 2004 (qualificação doutorado) ; Desenvolvimento de sistema de controle para uma planta de inertização de resíduos por plasma, Alexander, 2004 (qualificação doutorado)}.

     \item Combinação de duas fontes de energia para gerar um controle mais robusto na saída,{\bf Design of power control system using SMES and SVC for fusion power plant,K Niiyama e Hamajima 2008 (artigo)}.
         \end{itemize}

  }
  \frame
  {

    \begin{itemize}

    \item Discutidos as Características de corrente e voltagem na tocha, estabilidade do arco no plasma, característica do gradiente arco voltaico, analises da tocha plasmática, testes de temperatura do corpo da tocha, {\bf Performance of a plasma torch with hydrocarbon feedstocks for use in scramjet combustion, Jr. 1998 (MASTER of SCIENCE)}.

    \item Numerosas técnicas forem desenvolvidas sendo utilizados para a medição do plasma com o propósito de validar e controlar processos on-line, técnicas baseadas em sinal óptica, acústica e elétrica, {\bf Diagnostics of thermal plasmas, Boulos, 2006 (Artigo)}.

     \item Este relatório fala dos novos regimes de ignição plasmática e sistema de controle de intensidade, aplicados a mistura de ar e hidrocarbonetos, sistema de ignição de faisca é  reduzir o tempo até 100ns, {\bf Glow-to-Spark Transitions in a Plasma System for Ignition and Combustion Control, D. Korolev e Matveev 2007 (artigo)}.


    \end{itemize}

 }
  \frame
 {

    \begin{itemize}

      \item Apresenta exemplos de tecnologias com emprego do plasma térmico no tratamento de resíduos perigosos, incluindo resíduos orgânicos, são apresentados e discutidos os vários tipos de tochas a plasma, suas características, configurações e empregos mais adequados a cada tipo, {\bf O Plasma Térmico - Solução Final para os Resíduos Perigosos, Sichman n.d, 2006, (Relatório)}.

      \item Avaliação de controle, utilizando combinações de Fuzzy, PID, Redes Neurais e Algoritmos Genéticos, {\bf Análise comparativa do desempenho de um Controlador Fuzzy acoplado a um PID Neural sintonizado por um Algoritmo Genético com Controladores Inteligentes Convencionais, R. 2007, (Dissertação)}
          
      \item controle multivariavel da tocha Magnetic Control of plasma current, position, and shape in tokamaks, Giuseppe A., 2005, (revista)    



    \end{itemize}

 }
